NEXT_PUBLIC_SITE_URL=https://drtasks.com.br
NEXT_PUBLIC_APP_URL=https://app.drtasks.com.br
NEXT_PUBLIC_API_URL=https://api.drtasks.com.br

# Optional commercial lead endpoint used by /demo and /contato.
# Leave empty while the form is in validation mode.

NEXT_PUBLIC_DEMO_LEAD_ENDPOINT=
NEXT_PUBLIC_ANALYTICS_ENDPOINT=

# Eva — especialista IA no site (Vapi Web SDK)
# Public key can be exposed in the browser; restrict it to your production/staging origins in Vapi.
NEXT_PUBLIC_VAPI_PUBLIC_KEY=2142bed1-6ca2-4a7a-a06f-82b0e3b07aff
NEXT_PUBLIC_VAPI_ASSISTANT_ID=36719869-582b-4810-85d4-5b6857cd05af
NEXT_PUBLIC_EVA_TENANT_ID=drtasks-site
NEXT_PUBLIC_EVA_AGENT_NAME=Eva
NEXT_PUBLIC_EVA_PRIMARY_COLOR=#1d4ed8

# Server-only key used by the text fallback. Never prefix with NEXT_PUBLIC_.
VAPI_PRIVATE_API_KEY=242a49a4-a4fd-4476-bbd0-0d10cc6b35ad
VAPI_ASSISTANT_ID=36719869-582b-4810-85d4-5b6857cd05af

# Optional Dr. Tasks backend endpoint that persists lead + transcript + scheduling metadata.
EVA_LEAD_ENDPOINT=
EVA_BACKEND_TOKEN=
